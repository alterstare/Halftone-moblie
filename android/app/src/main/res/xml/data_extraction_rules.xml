<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device transfer: same as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nas.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nas.xml" />
    </device-transfer>
</data-extraction-rules>
